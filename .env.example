# Copy this file to .env and adjust the values.

# Address and port the Node server listens on.
# Keep 127.0.0.1 when Nginx (or another reverse proxy) runs on the same machine.
HOST=127.0.0.1
PORT=3000

# Folder holding the SQLite database (created automatically).
DATA_DIR=./data

# Folder where `npm run backup` writes its copies.
BACKUP_DIR=./backups
# How many backup files to keep (oldest are deleted).
BACKUP_KEEP=30

# Number of reverse proxies in front of the app (1 = Nginx). Set 0 if Node is exposed directly.
TRUST_PROXY=1

# Send the session cookie only over HTTPS. Keep "true" in production (HTTPS via Nginx + Let's Encrypt).
# Set "false" only for a local test over plain http://.
COOKIE_SECURE=true

# How long a login stays valid, in days.
SESSION_DAYS=30

# On the very first start (empty database), add the ADIDAS example quote and invoice.
SEED_DEMO=false

# Time zone used for dates and automatic numbering.
TZ=Europe/Paris

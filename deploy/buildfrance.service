# systemd unit for Build France - Devis & Factures
# Install: sudo cp deploy/buildfrance.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now buildfrance
[Unit]
Description=Build France - Devis & Factures (Node.js)
After=network.target

[Service]
Type=simple
User=buildfrance
Group=buildfrance
WorkingDirectory=/opt/buildfrance
EnvironmentFile=/opt/buildfrance/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buildfrance/data /opt/buildfrance/backups

[Install]
WantedBy=multi-user.target
